_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0}-\\overline{z_{0}}}{2i(Z_{0}-\\overline{z_{0}})} = \\frac{-2\\sqrt{5} \\cos \\theta - 2i\\sqrt{5} \\sin \\theta}{2i(2 + \\sqrt{5} \\cos \\theta + i \\sqrt{5} \\sin \\theta - 2 - \\sqrt{5} \\sin \\theta)}$$\n\n$$\\frac{4-z_{0