# SLURM
SLURM_ACCOUNT=ehpc715
SLURM_PARTITION=acc_ehpc
SLURM_QOS=acc_ehpc
SLURM_MAIL_USER=alielganzory@hotmail.com
SLURM_CPUS_PER_GPU=20
DISCOVERY_SLURM_MAX_TIME=00-01:00:00
EVAL_SLURM_MAX_TIME=03-00:00:00

# Cluster paths and modules (modules: space-separated list of `module load X` args)
WORK_DIR=$S
MODULES=cuda/12.6

# Multi-node networking (empty = no override)
NCCL_SOCKET_IFNAME=
GLOO_SOCKET_IFNAME=

# Distribution
EVAL_NUM_NODES=1
EVAL_GPUS_PER_NODE=4

# Debug
DEBUG_SHORT_DIST_TIMEOUT=False
