# SLURM
SLURM_ACCOUNT=reformo
SLURM_PARTITION=booster
SLURM_MAIL_USER=alielganzory@hotmail.com
SLURM_CPUS_PER_GPU=18
DISCOVERY_SLURM_MAX_TIME=00-01:00:00
EVAL_SLURM_MAX_TIME=00-12:00:00

# Cluster paths and modules (modules: space-separated list of `module load X` args)
WORK_DIR=/e/project1/reformo/ali
MODULES=Stages/2025 CUDA/12

# Multi-node networking (empty = no override)
NCCL_SOCKET_IFNAME=
GLOO_SOCKET_IFNAME=

# Distribution
EVAL_NUM_NODES=1
EVAL_GPUS_PER_NODE=1

# Debug
DEBUG_SHORT_DIST_TIMEOUT=False
